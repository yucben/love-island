[Unit]
Description=Love Island notification surface
PartOf=graphical-session.target
After=plasma-kwin_wayland.service
Before=plasma-plasmashell.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/love-island
ExecStartPre=/usr/bin/love-island-session prepare-osd
ExecStopPost=/usr/bin/love-island-session recover
Restart=no
TimeoutStartSec=15s
TimeoutStopSec=8s
Slice=session.slice

[Install]
WantedBy=plasma-core.target
