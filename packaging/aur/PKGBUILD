# Maintainer: yucben <139486997+yucben@users.noreply.github.com>
pkgname=love-island
pkgver=0.1.0
pkgrel=1
pkgdesc='Experimental island notification surface for KDE Plasma Wayland'
arch=('any')
url='https://github.com/yucben/love-island'
license=('MIT')
depends=('python' 'pyside6' 'python-dbus' 'python-gobject' 'layer-shell-qt'
         'plasma-workspace' 'kwin' 'libkscreen' 'kconfig' 'glib2' 'util-linux')
makedepends=('git')
optdepends=('libcanberra: notification sounds')
install=love-island.install
# Fixed release tag, not a rolling -git package. Git sources use SKIP.
source=("$pkgname::git+https://github.com/yucben/love-island.git#tag=v$pkgver")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname"
    install -d "$pkgdir/usr/lib/love-island/src" "$pkgdir/usr/lib/love-island/tools"
    cp -a src/dynamicisland "$pkgdir/usr/lib/love-island/src/"
    find "$pkgdir/usr/lib/love-island/src" -type d -name __pycache__ -prune -exec rm -rf {} +
    install -Dm755 tools/session.sh "$pkgdir/usr/lib/love-island/tools/session.sh"
    install -Dm755 packaging/session_bridge.py "$pkgdir/usr/lib/love-island/session-bridge"
    install -Dm755 packaging/love-island "$pkgdir/usr/bin/love-island"
    install -Dm755 packaging/love-island-session "$pkgdir/usr/bin/love-island-session"
    install -Dm644 packaging/love-island.service "$pkgdir/usr/lib/systemd/user/love-island.service"
    install -Dm644 packaging/love-island.desktop "$pkgdir/usr/share/applications/love-island.desktop"
    install -Dm644 packaging/love-island-restore.desktop "$pkgdir/usr/share/applications/love-island-restore.desktop"
    install -Dm644 packaging/love-island-autostart.desktop "$pkgdir/etc/xdg/autostart/love-island.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 docs/INSTALL.en.md "$pkgdir/usr/share/doc/$pkgname/INSTALL.en.md"
}
